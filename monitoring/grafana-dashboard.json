          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "100 * (sum(increase(llm_user_requests_total{status=~\"ok|client_disconnect\"}[$__range])) or vector(0)) / clamp_min(sum(increase(vllm:request_success_total[$__range])), 1)",
          "refId": "A"
        }
      ]
    }
